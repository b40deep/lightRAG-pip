    <node id="50% of men, 60% of women">
      <data key="d0">50% of men, 60% of women</data>
      <data key="d1">statistic</data>
      <data key="d2">These statistics indicate that 50% of men and 60% of women aged 25-34 are physically inactive, contributing to the high incidence of chronic diseases.</data>
      <data key="d3">chunk-0b7992edada8563b4687affa28b55ef3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890634</data>
    </node>
    <node id="one in five men, one in four women">
      <data key="d0">one in five men, one in four women</data>
      <data key="d1">statistic</data>
      <data key="d2">These statistics show that approximately 20% of men and 25% of women suffer from high blood pressure at a relatively young age.</data>
      <data key="d3">chunk-0b7992edada8563b4687affa28b55ef3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890634</data>
    </node>
    <node id="third of men, two-thirds of women">
