    <node id="heart disease, diabetes">
      <data key="d0">heart disease, diabetes</data>
      <data key="d1">category</data>
      <data key="d2">Heart disease and diabetes are chronic lifestyle-related illnesses that have high incidences in South African women compared to other populations mentioned.</data>
