    <node id="poor diet">
      <data key="d0">poor diet</data>
      <data key="d1">category</data>
      <data key="d2">Poor diet is linked to the development and progression of chronic diseases like heart disease and diabetes.</data>
      <data key="d3">chunk-0b7992edada8563b4687affa28b55ef3</data>
      <data key="d4">unknown_source</data>
