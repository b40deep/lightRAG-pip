      <data key="d5">1754897529</data>
    </node>
    <node id="non-breastfed children 12 months and older">
      <data key="d0">non-breastfed children 12 months and older</data>
      <data key="d3">chunk-98f5e59a0e47827af854be6c369f93f1</data>
      <data key="d2">Non-breastfed infants can use full-cream milk from the age of 12 months without needing infant formulas.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754897529</data>
    </node>
    <node id="full fat cheese">
      <data key="d0">full fat cheese</data>
      <data key="d3">chunk-98f5e59a0e47827af854be6c369f93f1</data>
      <data key="d2">Low-fat or fat-free cottage cheese is a healthier alternative to full-fat cheese in cooking.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754897529</data>
    </node>
    <node id="low-fat or fat-free cottage cheese">
      <data key="d0">low-fat or fat-free cottage cheese</data>
      <data key="d3">chunk-98f5e59a0e47827af854be6c369f93f1</data>
      <data key="d2">Low-fat or fat-free cottage cheese is a healthier alternative to full-fat cheese in cooking.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754897529</data>
    </node>
