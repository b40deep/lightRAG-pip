    </node>
    <node id="malt extract">
      <data key="d0">malt extract</data>
      <data key="d1">ingredient</data>
      <data key="d2">Malt extract is a concentrated form of malt that has been fermented and dehydrated, providing both sweet and savory flavors in baking and cooking.</data>
      <data key="d3">chunk-7b79825bf243d6abdec856f313bda4e9</data>
      <data key="d4">unknown_source</data>
