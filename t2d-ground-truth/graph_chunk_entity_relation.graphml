      <data key="d9">chunk-1cdb8446580c1ae7e773283e7ba7022b</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1754897518</data>
    </edge>
    <edge source="Portion Control Guide" target="Avoiding Overeating">
      <data key="d6">7.0</data>
      <data key="d7">The guide aims to help avoid overeating by promoting portion control habits.</data>
      <data key="d8">portion management,prevention of overeating</data>
      <data key="d9">chunk-1d3955361c770086424d86b70ae926bf</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1754897515</data>
    </edge>
    <edge source="Road-to-Health Book /The Caregiver Message Book: How to Raise a Healthy and Happy Child" target="Children">
      <data key="d6">8.0</data>
      <data key="d7">The book provides guidance on types of foods for children from six months to five years, contributing to their healthy development.</data>
      <data key="d8">child nutrition,developmental support</data>
      <data key="d9">chunk-1d3955361c770086424d86b70ae926bf</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1754897515</data>
    </edge>
    <edge source="WHO (World Health Organization)" target="Vegetables and Fruits">
      <data key="d6">9.0</data>
      <data key="d7">The WHO recommends consuming more than five portions of vegetables and fruits daily, emphasizing the health benefits of these foods.</data>
      <data key="d8">dietary guidelines,health promotion</data>
      <data key="d9">chunk-1d3955361c770086424d86b70ae926bf</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1754897515</data>
    </edge>
    <edge source="Cooking Methods" target="Avoiding Overeating">
      <data key="d6">6.0</data>
      <data key="d7">Different cooking methods are suggested to use in place of frying, which can help reduce calorie intake and prevent overeating.</data>
      <data key="d8">cooking techniques,weight management</data>
      <data key="d9">chunk-1d3955361c770086424d86b70ae926bf</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1754897516</data>
    </edge>
    <edge source="Regular Meals" target="Nutrition Needs">
      <data key="d6">8.0</data>
      <data key="d7">Eating regularly helps manage nutritional needs across different life stages by preventing feelings of hunger and low blood sugar.</data>
      <data key="d8">dietary consistency,health maintenance</data>
      <data key="d9">chunk-1d3955361c770086424d86b70ae926bf</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1754897516</data>
    </edge>
    <edge source="Nutrition Needs" target="Children">
      <data key="d6">7.0</data>
      <data key="d7">Nutritional advice is specifically tailored for children, highlighting the importance of varied and appropriate food choices during their development.</data>
      <data key="d8">child nutrition,dietary requirements</data>
      <data key="d9">chunk-1d3955361c770086424d86b70ae926bf</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1754897517</data>
    </edge>
    <edge source="Nutrition Needs" target="Thickened Cooked Porridge">
      <data key="d6">7.0</data>
      <data key="d7">Thickened cooked porridge is recommended as a nutritious and safe option for young children, especially when prepared with enriching ingredients.</data>
      <data key="d8">nutritional support,safe food options</data>
      <data key="d9">chunk-1d3955361c770086424d86b70ae926bf</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1754897517</data>
    </edge>
    <edge source="Foods That Can Cause Choking" target="Children">
      <data key="d6">8.0</data>
      <data key="d7">Choking hazards such as nuts, seeds, grapes, and large pieces of vegetables are mentioned to be avoided for young children's safety.</data>
      <data key="d8">dietary guidance,safety concerns</data>
      <data key="d9">chunk-1d3955361c770086424d86b70ae926bf</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1754897517</data>
    </edge>
    <edge source="home-cooked meals" target="ultra-processed foods">
      <data key="d6">9.0</data>
      <data key="d7">Eating home-cooked meals regularly reduces the intake of ultra-processed foods, which are often high in calories and low in nutrients.</data>
      <data key="d8">9</data>
      <data key="d9">chunk-fb7f9553a2f42b8058dc0445b5667f49</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1754897518</data>
    </edge>
    <edge source="home-cooked meals" target="carbon footprint">
      <data key="d6">8.0</data>
      <data key="d7">Home-cooked meals have a lower carbon footprint compared to eating out or consuming fast food, as they involve less packaging and transportation.</data>
      <data key="d8">8</data>
      <data key="d9">chunk-fb7f9553a2f42b8058dc0445b5667f49</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1754897519</data>
    </edge>
    <edge source="home-cooked meals" target="green lunch club">
      <data key="d6">6.0</data>
      <data key="d7">Green lunch clubs promote the consumption of home-cooked, plant-based lunches at work, supporting healthier eating habits.</data>
      <data key="d8">6</data>
      <data key="d9">chunk-fb7f9553a2f42b8058dc0445b5667f49</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1754897520</data>
    </edge>
    <edge source="menu plan" target="portion control guide">
      <data key="d6">6.0</data>
      <data key="d7">The portion control guide can be used in conjunction with the menu plan to ensure appropriate serving sizes are followed.</data>
      <data key="d8">6</data>
      <data key="d9">chunk-fb7f9553a2f42b8058dc0445b5667f49</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1754897518</data>
    </edge>
    <edge source="annexure vi" target="menu planning">
      <data key="d6">8.0</data>
      <data key="d7">Annexure VI provides practical examples of menu plans, which are useful for meal planning and preparation.</data>
      <data key="d8">8</data>
      <data key="d9">chunk-fb7f9553a2f42b8058dc0445b5667f49</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1754897518</data>
    </edge>
    <edge source="dietitians" target="annexure i">
      <data key="d6">7.0</data>
      <data key="d7">The South African Guidelines for Healthy Eating are created by dietitians to provide expert advice on nutrition and healthy habits.</data>
      <data key="d8">7</data>
      <data key="d9">chunk-fb7f9553a2f42b8058dc0445b5667f49</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1754897517</data>
    </edge>
    <edge source="green lunch club" target="plant-based meals">
      <data key="d6">9.0</data>
      <data key="d7">Green lunch clubs encourage the consumption of whole plant-based lunches, which aligns with healthy eating guidelines provided in Annexure I.</data>
      <data key="d8">9</data>
      <data key="d9">chunk-fb7f9553a2f42b8058dc0445b5667f49</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1754897521</data>
    </edge>
