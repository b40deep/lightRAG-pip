    </node>
    <node id="invert sugar">
      <data key="d0">invert sugar</data>
      <data key="d1">ingredient</data>
      <data key="d2">Invert sugar, formed when sucrose is split into fructose and glucose, is often added to foods to prevent crystallization and add sweetness.</data>
      <data key="d3">chunk-7b79825bf243d6abdec856f313bda4e9</data>
      <data key="d4">unknown_source</data>
