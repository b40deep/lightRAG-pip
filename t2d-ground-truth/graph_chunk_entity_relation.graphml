    <node id="10 Guidelines">
      <data key="d0">10 Guidelines</data>
      <data key="d1">category</data>
      <data key="d2">A set of 10 guidelines designed to help maintain a healthy lifestyle and prevent chronic diseases.</data>
      <data key="d3">chunk-4ab7e41bfc6dc460c48107220733a6cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890534</data>
    </node>
    <node id="healthy eating">
      <data key="d0">healthy eating</data>
      <data key="d1">category</data>
      <data key="d2">Category related to diet and nutrition practices.</data>
      <data key="d3">chunk-4ab7e41bfc6dc460c48107220733a6cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890534</data>
    </node>
    <node id="diabetes">
      <data key="d0">diabetes</data>
      <data key="d1">category</data>
      <data key="d2">Category related to the disease diabetes.</data>
      <data key="d3">chunk-4ab7e41bfc6dc460c48107220733a6cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890534</data>
    </node>
    <node id="Plate model">
      <data key="d0">Plate model</data>
      <data key="d1">category</data>
      <data key="d2">A dietary guide or visual tool for portion control and food distribution on a plate.&lt;SEP&gt;The Plate model is a visual guide used in dietary recommendations to show the distribution of food groups on one's plate for balanced eating.</data>
      <data key="d3">chunk-7b79825bf243d6abdec856f313bda4e9&lt;SEP&gt;chunk-4ab7e41bfc6dc460c48107220733a6cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890536</data>
    </node>
    <node id="portion sizes">
      <data key="d0">portion sizes</data>
      <data key="d1">category</data>
      <data key="d2">Amounts of food that should be consumed at one time, often used in nutrition guidelines.</data>
      <data key="d3">chunk-4ab7e41bfc6dc460c48107220733a6cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890536</data>
    </node>
    <node id="physical activity">
      <data key="d0">physical activity</data>
      <data key="d1">category</data>
      <data key="d2">Engagement in exercise or movement to maintain health.</data>
      <data key="d3">chunk-4ab7e41bfc6dc460c48107220733a6cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890536</data>
    </node>
    <node id="smoking">
      <data key="d0">smoking</data>
      <data key="d1">category</data>
      <data key="d2">The practice of inhaling tobacco smoke through a cigarette, often associated with health risks.</data>
      <data key="d3">chunk-4ab7e41bfc6dc460c48107220733a6cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890536</data>
    </node>
    <node id="energy">
      <data key="d0">energy</data>
      <data key="d1">category</data>
      <data key="d2">The capacity to do work, often related to the body's ability to function and perform tasks.</data>
      <data key="d3">chunk-4ab7e41bfc6dc460c48107220733a6cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890536</data>
    </node>
    <node id="different color groups">
      <data key="d0">different color groups</data>
      <data key="d1">category</data>
      <data key="d2">Different color groups of vegetables and fruits such as red, green, yellow, and orange are recommended to ensure a wide variety of nutrients.</data>
      <data key="d3">chunk-4ab7e41bfc6dc460c48107220733a6cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890536</data>
    </node>
    <node id="protein">
      <data key="d0">protein</data>
      <data key="d1">category</data>
      <data key="d2">Protein is a nutrient found in foods like dry beans, split peas, lentils, or soya, which are also high in fiber and low in fat.</data>
      <data key="d3">chunk-4ab7e41bfc6dc460c48107220733a6cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890536</data>
    </node>
    <node id="fibre">
      <data key="d0">fibre</data>
      <data key="d1">category</data>
      <data key="d2">Fiber is an important component of the diet recommended for those with diabetes, especially from sources like vegetables, fruits, and legumes.</data>
      <data key="d3">chunk-4ab7e41bfc6dc460c48107220733a6cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890536</data>
    </node>
    <node id="bad fats">
      <data key="d0">bad fats</data>
      <data key="d1">category</data>
      <data key="d2">Bad fats refer to saturated fats that can increase cholesterol levels and block blood vessels, contributing to heart disease and stroke risks.</data>
      <data key="d3">chunk-4ab7e41bfc6dc460c48107220733a6cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890537</data>
    </node>
    <node id="dairy products">
      <data key="d0">dairy products</data>
      <data key="d1">category</data>
      <data key="d2">Dairy products like milk, maas, and yoghurt are suggested for their calcium content, which helps protect against diseases such as osteoporosis and heart disease.</data>
      <data key="d3">chunk-4ab7e41bfc6dc460c48107220733a6cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890537</data>
    </node>
    <node id="sugar">
      <data key="d0">sugar</data>
      <data key="d1">category</data>
      <data key="d2">Sugar is a carbohydrate found in many processed foods and can be consumed excessively when eating out or consuming fast foods.&lt;SEP&gt;Sugar is commonly added to food to enhance sweetness; it can be found under various names as mentioned in the text.&lt;SEP&gt;Sugar is mentioned as a nutrient that should be consumed in moderation to avoid gaining weight and increasing the risk of chronic diseases.</data>
      <data key="d3">chunk-7b79825bf243d6abdec856f313bda4e9&lt;SEP&gt;chunk-4ab7e41bfc6dc460c48107220733a6cc&lt;SEP&gt;chunk-fb7f9553a2f42b8058dc0445b5667f49</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754897491</data>
    </node>
    <node id="fats">
      <data key="d0">fats</data>
      <data key="d1">category</data>
      <data key="d2">"Fats are listed on food labels to help consumers understand the amount of total and saturated fats in a product, especially important when aiming for less than 10g per 100g." description not available in text.&lt;SEP&gt;Fats are discussed as a category of nutrients that should be used sparingly, with emphasis on choosing unsaturated fats over saturated ones for better heart health.</data>
      <data key="d3">chunk-d5ee0362fd9870828ed03fba0664efdf&lt;SEP&gt;chunk-4ab7e41bfc6dc460c48107220733a6cc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890538</data>
    </node>
    <node id="good fats">
      <data key="d0">good fats</data>
      <data key="d1">category</data>
      <data key="d2">"Good fats refer to unsaturated fats such as oils (canola, olive or sunflower oil) and soft tub margarine that are recommended for use in small to moderate amounts."&lt;</data>
      <data key="d3">chunk-b3fcb68825e6fe0cbbb4c9ec35afb646</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890538</data>
    </node>
    <node id="impaired glucose tolerance">
      <data key="d0">impaired glucose tolerance</data>
      <data key="d1">condition</data>
      <data key="d2">"Impaired glucose tolerance refers to a state where blood glucose levels are elevated above normal but not high enough to be classified as diabetes; it is often a precursor to Type 2 diabetes."&lt;</data>
      <data key="d3">chunk-b3fcb68825e6fe0cbbb4c9ec35afb646</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890538</data>
    </node>
    <node id="Type 2 Diabetes">
      <data key="d0">Type 2 Diabetes</data>
      <data key="d1">category</data>
      <data key="d2">People with Type 2 diabetes benefit from exercise for weight management and insulin efficiency, reducing the risk of complications such as eye, kidney, and heart diseases.&lt;SEP&gt;Type 2 Diabetes refers to a chronic condition characterized by high blood glucose levels due to insulin resistance or deficiency and often requires lifestyle changes and medication for management.&lt;SEP&gt;Type 2 diabetes is a specific form of diabetes where the body does not produce enough insulin or cannot effectively use the insulin it makes, often associated with lifestyle factors.</data>
      <data key="d3">chunk-f5fc341d7bf2fb8dcae642731ec8fb0d&lt;SEP&gt;chunk-129a310c5d71871c9ee11cf249dcb6c3&lt;SEP&gt;chunk-9c3dada45a598da1af9a6c9dc041e660</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890538</data>
    </node>
    <node id="Impaired Glucose Tolerance">
      <data key="d0">Impaired Glucose Tolerance</data>
      <data key="d1">category</data>
      <data key="d2">Impaired Glucose Tolerance is a condition indicating elevated blood sugar levels, but not yet at the threshold of diabetes. It can progress to Type 2 Diabetes if lifestyle factors are not improved.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890538</data>
    </node>
    <node id="Gestational Diabetes (GDM)">
      <data key="d0">Gestational Diabetes (GDM)</data>
      <data key="d1">category</data>
      <data key="d2">Gestational Diabetes is a form of diabetes that occurs during pregnancy and often resolves after childbirth but increases the risk for developing Type 2 Diabetes later on.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890539</data>
    </node>
    <node id="Pre-diabetes">
      <data key="d0">Pre-diabetes</data>
      <data key="d1">category</data>
      <data key="d2">Pre-diabetes describes conditions where blood glucose levels are higher than normal, but not high enough to be classified as diabetes. It serves as a warning sign that may develop into Type 2 Diabetes if not managed.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890539</data>
    </node>
    <node id="Hypoglycaemia">
      <data key="d0">Hypoglycaemia</data>
      <data key="d1">event</data>
      <data key="d2">Hypoglycaemia is a condition where blood sugar levels drop too low due to alcohol consumption without eating or with certain medications. It is important for people with diabetes to be aware of this risk."&lt;&lt;关系描述&gt;&gt;"Description not available in text.&lt;SEP&gt;Hypoglycaemia is the condition of having low blood sugar levels, which can cause symptoms such as tiredness and confusion, and poses a risk of severe complications if not treated promptly.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3&lt;SEP&gt;chunk-6699a5c79683213ff4dea6e14b493c72</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890539</data>
    </node>
    <node id="Hyperglycaemia">
      <data key="d0">Hyperglycaemia</data>
      <data key="d1">event</data>
      <data key="d2">Hyperglycaemia is when blood glucose levels rise too high, potentially leading to the production of ketones and conditions like ketoacidosis in people with Type 1 diabetes.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890539</data>
    </node>
    <node id="Ketoacidosis">
      <data key="d0">Ketoacidosis</data>
      <data key="d1">category</data>
      <data key="d2">Ketoacidosis is a serious condition caused by excessive ketone build-up in the bloodstream due to insufficient insulin, commonly seen in unmanaged Type 1 Diabetes.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890539</data>
    </node>
    <node id="Short Term Complications of Diabetes">
      <data key="d0">Short Term Complications of Diabetes</data>
      <data key="d1">event</data>
      <data key="d2">Short term complications include hypoglycaemia and hyperglycaemia, which can lead to immediate health issues such as fainting or ketoacidosis if not managed properly.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890539</data>
    </node>
    <node id="Long Term Complications of Diabetes">
      <data key="d0">Long Term Complications of Diabetes</data>
      <data key="d1">event</data>
      <data key="d2">Long term complications arise from consistently high blood glucose levels over time, leading to damage in blood vessels and increased risk for heart disease, kidney failure, eye problems, nerve issues, infections, and lower limb amputations.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890540</data>
    </node>
    <node id="Healthy Eating Habits">
      <data key="d0">Healthy Eating Habits</data>
      <data key="d1">category</data>
      <data key="d2">Healthy eating habits involve consuming a balanced diet with controlled portion sizes to manage diabetes effectively. It is crucial for overall health and managing blood glucose levels.&lt;SEP&gt;Healthy eating habits refer to consuming food in controlled portions and selecting nutritious foods, particularly managing carbohydrate intake.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3&lt;SEP&gt;chunk-3c6dac05970727d54d46abd86982b759</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890540</data>
    </node>
    <node id="Regular Exercise">
      <data key="d0">Regular Exercise</data>
      <data key="d1">category</data>
      <data key="d2">Regular exercise is important in the management of diabetes, contributing to better insulin sensitivity and improved blood sugar control.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890540</data>
    </node>
    <node id="Oral Medication">
      <data key="d0">Oral Medication</data>
      <data key="d1">category</data>
      <data key="d2">Oral medication is one form of treatment for Type 2 Diabetes that helps manage blood glucose levels when combined with lifestyle changes.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890540</data>
    </node>
    <node id="Insulin Injections">
      <data key="d0">Insulin Injections</data>
      <data key="d1">category</data>
      <data key="d2">Insulin injections are a common treatment method for managing blood glucose levels in people living with diabetes, especially those who have Type 1 or severe cases of Type 2 Diabetes.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890541</data>
    </node>
    <node id="Routine Blood or Urine Glucose Test">
      <data key="d0">Routine Blood or Urine Glucose Test</data>
      <data key="d1">category</data>
      <data key="d2">Routine blood or urine glucose tests are standard medical procedures used to screen for diabetes or monitor its progression by measuring blood sugar levels.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890541</data>
    </node>
    <node id="Insulin Resistance">
      <data key="d0">Insulin Resistance</data>
      <data key="d1">category</data>
      <data key="d2">Insulin resistance is a condition where the body's cells do not respond properly to insulin, leading to high blood sugar levels and often progressing to Type 2 Diabetes.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890541</data>
    </node>
    <node id="Healthy Diet">
      <data key="d0">Healthy Diet</data>
      <data key="d1">category</data>
      <data key="d2">A healthy diet involves consuming a balanced and nutritious meal plan that is crucial for managing Type 2 Diabetes. It helps in controlling blood sugar levels and overall health.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890541</data>
    </node>
    <node id="Physical Activity">
      <data key="d0">Physical Activity</data>
      <data key="d1">category</data>
      <data key="d2">Physical activity is any bodily movement produced by the contraction of skeletal muscles that increases energy expenditure. Regular physical activity can help manage Type 2 Diabetes by improving insulin sensitivity and blood glucose levels.&lt;SEP&gt;Physical activity refers to any form of exercise or movement that helps improve heart health, blood glucose control, cholesterol levels, and overall quality of life.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3&lt;SEP&gt;chunk-3c6dac05970727d54d46abd86982b759</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890541</data>
    </node>
    <node id="Ketone Strips">
      <data key="d0">Ketone Strips</data>
      <data key="d1">equipment</data>
      <data key="d2">Ketone strips are test strips used to detect the presence of ketones in urine. They help monitor for ketoacidosis, a serious complication in people with Type 1 Diabetes or severe cases of Type 2 Diabetes.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890542</data>
    </node>
    <node id="Healthcare Professional">
      <data key="d0">Healthcare Professional</data>
      <data key="d1">person</data>
      <data key="d2">A healthcare professional is a medical practitioner who provides advice and support to people with diabetes. They help in managing the condition through various means including medication, lifestyle changes, and regular check-ups.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890542</data>
    </node>
    <node id="Ketoacidosis (Type 1 Diabetes)">
      <data key="d0">Ketoacidosis (Type 1 Diabetes)</data>
      <data key="d1">category</data>
      <data key="d2">Ketoacidosis is a serious condition in which high levels of ketones accumulate in the bloodstream. It commonly occurs in people with Type 1 Diabetes when there is insufficient insulin.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890542</data>
    </node>
    <node id="Nausea and Vomiting">
      <data key="d0">Nausea and Vomiting</data>
      <data key="d1">symptom</data>
      <data key="d2">Nausea and vomiting are symptoms that can occur as a result of high blood glucose levels. They may indicate the presence of hyperglycaemia or other complications.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890542</data>
    </node>
    <node id="Lower Limb Amputations">
      <data key="d0">Lower Limb Amputations</data>
      <data key="d1">complication</data>
      <data key="d2">Lower limb amputations are a severe long-term complication of diabetes that can occur due to poor blood circulation and nerve damage. Effective management is crucial to prevent this.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890542</data>
    </node>
    <node id="Blood Vessel Damage">
      <data key="d0">Blood Vessel Damage</data>
      <data key="d1">complication</data>
      <data key="d2">Damage to blood vessels is a common long-term complication of diabetes that can affect the heart, eyes, kidneys, and nerves. Managing glucose levels helps prevent this.</data>
      <data key="d3">chunk-129a310c5d71871c9ee11cf249dcb6c3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890542</data>
    </node>
    <node id="Portion Sizes">
      <data key="d0">Portion Sizes</data>
      <data key="d1">category</data>
      <data key="d2">Controlling portion sizes is an important aspect of healthy eating, especially for people with diabetes.&lt;SEP&gt;Portion sizes for vegetables can vary based on availability but should be generous when a variety is not available.</data>
      <data key="d3">chunk-3c6dac05970727d54d46abd86982b759&lt;SEP&gt;chunk-baf922dec0d429fd4c06191ccab7f11c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754897486</data>
    </node>
    <node id="Blood Sugar Levels">
      <data key="d0">Blood Sugar Levels</data>
      <data key="d1">category</data>
      <data key="d2">Blood Sugar Levels refer to the concentration of glucose in the bloodstream, which is a key indicator for diagnosing and managing diabetes. These levels can be assessed via routine tests or glucose tolerance tests and are closely monitored in individuals with diabetes, as they can be influenced by carbohydrate intake. Maintaining stable blood sugar levels through diet is crucial for overall health; foods such as legumes, sweet potato, oats, and oat bran, which have a low glycaemic index (GI), provide slower-releasing energy and help manage these levels effectively.</data>
      <data key="d3">chunk-58067acb0a4b21e48e826dd7e97d86a5&lt;SEP&gt;chunk-129a310c5d71871c9ee11cf249dcb6c3&lt;SEP&gt;chunk-520eb52d6ccc68c424c497fa7e6df29a&lt;SEP&gt;chunk-3c6dac05970727d54d46abd86982b759</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890543</data>
    </node>
    <node id="Carbohydrates">
      <data key="d0">Carbohydrates</data>
      <data key="d1">category</data>
      <data key="d2">Carbohydrates are a type of nutrient that have the biggest effect on blood sugar levels and should be managed carefully by people with diabetes.</data>
      <data key="d3">chunk-3c6dac05970727d54d46abd86982b759</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890543</data>
    </node>
    <node id="Starches">
      <data key="d0">Starches</data>
      <data key="d1">category</data>
      <data key="d2">Starches include bread, pasta, rice, pap and starchy vegetables like potatoes and butternut. They are part of the carbohydrate group.&lt;SEP&gt;Starchy foods like rice or potatoes are mentioned as common side dish options but recommend choosing healthier alternatives.</data>
      <data key="d3">chunk-432b00aa4a62ed1cc5b80a9b6a970a9c&lt;SEP&gt;chunk-3c6dac05970727d54d46abd86982b759</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890543</data>
    </node>
    <node id="Sugars">
      <data key="d0">Sugars</data>
      <data key="d1">category</data>
      <data key="d2">Sugar is a type of carbohydrate found in sweets, chocolates, cakes, treats, cold drinks, and other refined products. It should be consumed in controlled quantities by people with diabetes.</data>
      <data key="d3">chunk-3c6dac05970727d54d46abd86982b759</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890543</data>
    </node>
    <node id="Dairy">
      <data key="d0">Dairy</data>
      <data key="d1">category</data>
      <data key="d2">Dairy foods can contain natural sugars and should be eaten in controlled portions to manage blood sugar levels.</data>
      <data key="d3">chunk-3c6dac05970727d54d46abd86982b759</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890543</data>
    </node>
    <node id="Fruits">
      <data key="d0">Fruits</data>
      <data key="d1">category</data>
      <data key="d2">Fresh fruits are recommended for their nutritional value and help in managing blood sugar levels compared to processed snacks."&lt;&lt;关系描述&gt;&gt;"Nutritional value, blood sugar management&lt;SEP&gt;Fruits are a type of food that contains natural sugars and should be part of the diet for people with diabetes, but consumed in appropriate quantities.&lt;SEP&gt;Fruits contain natural sugars which can affect blood sugar levels but do not provide detailed information on their nutritional value or energy content.</data>
      <data key="d3">chunk-58067acb0a4b21e48e826dd7e97d86a5&lt;SEP&gt;chunk-3c6dac05970727d54d46abd86982b759&lt;SEP&gt;chunk-6699a5c79683213ff4dea6e14b493c72</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890544</data>
    </node>
    <node id="Nuts">
      <data key="d0">Nuts</data>
      <data key="d1">category</data>
      <data key="d2">Eating nuts is encouraged for their nutritional value but should be done in appropriate portions.</data>
      <data key="d3">chunk-3c6dac05970727d54d46abd86982b759</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890544</data>
    </node>
    <node id="Unsweetened Dairy Products">
      <data key="d0">Unsweetened Dairy Products</data>
      <data key="d1">category</data>
      <data key="d2">Unsweetened dairy products are recommended as a healthier alternative to sweetened ones, especially for people with diabetes.</data>
      <data key="d3">chunk-3c6dac05970727d54d46abd86982b759</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890544</data>
    </node>
    <node id="Good Choices">
      <data key="d0">Good Choices</data>
      <data key="d1">category</data>
      <data key="d2">Making good choices involves selecting nutritious foods like fruits, vegetables, nuts, and unsweetened dairy over less healthy options.</data>
      <data key="d3">chunk-3c6dac05970727d54d46abd86982b759</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890544</data>
    </node>
    <node id="Nutritional Value">
      <data key="d0">Nutritional Value</data>
      <data key="d1">category</data>
      <data key="d2">Eating a variety of foods high in nutritional value is important for overall health and managing blood sugar levels.</data>
      <data key="d3">chunk-3c6dac05970727d54d46abd86982b759</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890545</data>
    </node>
    <node id="Resistance Training">
      <data key="d0">Resistance Training</data>
      <data key="d1">category</data>
      <data key="d2">Resistance training includes weightlifting and bodyweight exercises such as push-ups. It is part of a balanced exercise regimen for managing diabetes.</data>
      <data key="d3">chunk-3c6dac05970727d54d46abd86982b759</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890545</data>
    </node>
    <node id="Aerobic Exercises">
      <data key="d0">Aerobic Exercises</data>
      <data key="d1">category</data>
      <data key="d2">Aerobic exercises include activities like running, cycling, or brisk walking. They are recommended to be combined with resistance training in an exercise program.</data>
      <data key="d3">chunk-3c6dac05970727d54d46abd86982b759</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890545</data>
    </node>
    <node id="Well-fitting Footwear">
      <data key="d0">Well-fitting Footwear</data>
      <data key="d1">category</data>
      <data key="d2">Well-fitting footwear is important for maintaining foot health, especially during exercise.</data>
      <data key="d3">chunk-f5fc341d7bf2fb8dcae642731ec8fb0d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890545</data>
    </node>
    <node id="Family, Friends, Colleagues">
      <data key="d0">Family, Friends, Colleagues</data>
      <data key="d1">person</data>
      <data key="d2">Family, friends, and colleagues can provide support during the start of a new exercise program.</data>
      <data key="d3">chunk-f5fc341d7bf2fb8dcae642731ec8fb0d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890545</data>
    </node>
    <node id="Activity Diary">
      <data key="d0">Activity Diary</data>
      <data key="d1">category</data>
      <data key="d2">Keeping an activity diary helps stay motivated during an exercise program.</data>
      <data key="d3">chunk-f5fc341d7bf2fb8dcae642731ec8fb0d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890546</data>
    </node>
    <node id="Exercise Program">
      <data key="d0">Exercise Program</data>
      <data key="d1">event</data>
      <data key="d2">Starting a new exercise program can help manage Type 2 diabetes through weight loss and improved insulin utilization.</data>
      <data key="d3">chunk-f5fc341d7bf2fb8dcae642731ec8fb0d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890546</data>
    </node>
    <node id="Blood Pressure Reduction">
      <data key="d0">Blood Pressure Reduction</data>
      <data key="d1">category</data>
      <data key="d2">Regular exercise helps lower blood pressure, beneficial for people with diabetes to reduce the risk of complications.</data>
      <data key="d3">chunk-f5fc341d7bf2fb8dcae642731ec8fb0d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890546</data>
    </node>
    <node id="Smoking">
      <data key="d0">Smoking</data>
      <data key="d1">category</data>
      <data key="d2">Smoking is not recommended for people with diabetes as it increases the risk of heart disease and other complications.</data>
      <data key="d3">chunk-f5fc341d7bf2fb8dcae642731ec8fb0d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890546</data>
    </node>
    <node id="Second-hand Smoke">
      <data key="d0">Second-hand Smoke</data>
      <data key="d1">category</data>
      <data key="d2">People exposed to second-hand smoke have a higher risk of heart disease and premature death, especially those with diabetes.</data>
      <data key="d3">chunk-f5fc341d7bf2fb8dcae642731ec8fb0d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890546</data>
    </node>
    <node id="Heart Disease Risk">
      <data key="d0">Heart Disease Risk</data>
      <data key="d1">category</data>
      <data key="d2">Smoking can accelerate the small blood vessel damage in people with diabetes, increasing their risk of heart diseases.</data>
      <data key="d3">chunk-f5fc341d7bf2fb8dcae642731ec8fb0d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890546</data>
    </node>
    <node id="Quit Smoking">
      <data key="d0">Quit Smoking</data>
      <data key="d1">event</data>
      <data key="d2">Quitting smoking is crucial for people diagnosed with diabetes to reduce cardiovascular risks.</data>
      <data key="d3">chunk-f5fc341d7bf2fb8dcae642731ec8fb0d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890546</data>
    </node>
    <node id="Lifestyle Changes">
      <data key="d0">Lifestyle Changes</data>
      <data key="d1">category</data>
      <data key="d2">Making lifestyle changes such as diet and exercise are the most effective ways to prevent and manage lifestyle diseases like diabetes and heart disease.</data>
      <data key="d3">chunk-f5fc341d7bf2fb8dcae642731ec8fb0d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890547</data>
    </node>
    <node id="Diabetes Medications">
      <data key="d0">Diabetes Medications</data>
      <data key="d1">category</data>
      <data key="d2">Diabetes medications help lower blood glucose levels, but should be taken in combination with a healthy diet and regular exercise.</data>
      <data key="d3">chunk-f5fc341d7bf2fb8dcae642731ec8fb0d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890547</data>
    </node>
    <node id="Home Blood Sugar Monitor">
      <data key="d0">Home Blood Sugar Monitor</data>
      <data key="d1">equipment</data>
      <data key="d2">Home blood sugar monitors allow individuals to track their glucose levels and manage diabetes more effectively.</data>
      <data key="d3">chunk-f5fc341d7bf2fb8dcae642731ec8fb0d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890547</data>
    </node>
    <node id="HbA1c Blood Test">
      <data key="d0">HbA1c Blood Test</data>
      <data key="d1">test</data>
      <data key="d2">An HbA1c test provides an overall picture of average blood sugar levels over a three-month period, guiding healthcare professionals in managing diabetes.</data>
      <data key="d3">chunk-f5fc341d7bf2fb8dcae642731ec8fb0d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890547</data>
    </node>
    <node id="Starch">
      <data key="d0">Starch</data>
      <data key="d1">category</data>
      <data key="d2">A general term for any kind of carbohydrate that can be used to fill up a plate and provide a balanced meal.&lt;SEP&gt;Starch is a carbohydrate-rich food group important for energy and digestion but can significantly affect blood glucose levels.&lt;SEP&gt;Starchy foods include bread, brown rice, lentils, pap, pasta, porridge, rotis, samp, and wholegrain cereal. These are high in carbs and should be consumed in controlled portions to maintain blood sugar levels.</data>
      <data key="d3">chunk-f5fc341d7bf2fb8dcae642731ec8fb0d&lt;SEP&gt;chunk-15a1bd10d7b9d9f5d5740a37592a65b5&lt;SEP&gt;chunk-58067acb0a4b21e48e826dd7e97d86a5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890547</data>
    </node>
    <node id="Non-Starchy Vegetables">
      <data key="d0">Non-Starchy Vegetables</data>
      <data key="d1">category</data>
      <data key="d2">Non-starchy vegetables are low in energy, high in nutrients, and help maintain a balanced diet without contributing much to weight gain.</data>
      <data key="d3">chunk-f5fc341d7bf2fb8dcae642731ec8fb0d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890547</data>
    </node>
    <node id="Proteins">
      <data key="d0">Proteins</data>
      <data key="d1">category</data>
      <data key="d2">Proteins provide essential amino acids for muscle repair and growth but their portion size should be managed with other food groups.</data>
      <data key="d3">chunk-f5fc341d7bf2fb8dcae642731ec8fb0d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890547</data>
    </node>
    <node id="Fats">
      <data key="d0">Fats</data>
      <data key="d1">category</data>
      <data key="d2">Healthy fats are important, but their portion sizes need to be controlled as part of a balanced diet.&lt;SEP&gt;Healthy fats from nuts, avocado, olives, seeds, and oily fish can provide energy and help absorb fat-soluble vitamins.</data>
      <data key="d3">chunk-f5fc341d7bf2fb8dcae642731ec8fb0d&lt;SEP&gt;chunk-58067acb0a4b21e48e826dd7e97d86a5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890547</data>
    </node>
    <node id="Vegetables">
      <data key="d0">Vegetables</data>
      <data key="d1">category</data>
      <data key="d2">Vegetables are a category of plant-based food items like mushrooms, aubergine, baby marrow, among others.&lt;SEP&gt;Vegetables play a crucial role in maintaining a balanced diet, particularly when managing carbohydrate intake for those on a low-carb regimen or seeking to fill their plates with nutrient-rich options. The recommended vegetables include a diverse range such as baby marrows, beetroot, brinjal, broccoli, cabbage, carrots, cauliflower, celery, cucumber, green beans, lettuce, marogo, mushrooms, onions, peppers, spinach, and tomatoes. These non-starchy vegetables are low in carbohydrates but rich in vitamins and fibre, making them suitable for managing carb intake while providing essential nutrients. It is important to note that some vegetables can contain natural sugars, which should be managed as part of overall carbohydrate consumption. To achieve a balanced diet, portion control is advised along with the inclusion of interesting and flavorful vegetable options such as salads and other interesting combinations in meals.</data>
      <data key="d3">chunk-3c6dac05970727d54d46abd86982b759&lt;SEP&gt;chunk-58067acb0a4b21e48e826dd7e97d86a5&lt;SEP&gt;chunk-baf922dec0d429fd4c06191ccab7f11c&lt;SEP&gt;chunk-432b00aa4a62ed1cc5b80a9b6a970a9c&lt;SEP&gt;chunk-6699a5c79683213ff4dea6e14b493c72</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754897485</data>
    </node>
    <node id="Nonstarchy Vegetables">
      <data key="d0">Nonstarchy Vegetables</data>
      <data key="d1">category</data>
      <data key="d2">Nonstarchy vegetables are low in energy but high in nutritional value, rich in vitamins, minerals, and fibre. They do not lead to weight gain when prepared healthily.</data>
      <data key="d3">chunk-58067acb0a4b21e48e826dd7e97d86a5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890548</data>
    </node>
    <node id="Protein Portion Size">
      <data key="d0">Protein Portion Size</data>
      <data key="d1">category</data>
      <data key="d2">The recommended protein portion size is the size of the palm of your hand or a quarter of the plate, including choices like meat, fish, chicken and turkey, eggs, beans, lentils, soya, and cheese.</data>
      <data key="d3">chunk-58067acb0a4b21e48e826dd7e97d86a5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890549</data>
    </node>
    <node id="Healthy Fats">
      <data key="d0">Healthy Fats</data>
      <data key="d1">category</data>
      <data key="d2">Healthy fats are important sources of energy for the body and necessary to absorb fat-soluble vitamins. They should be chosen from nuts, avocado, olives, seeds, and oily fish.</data>
      <data key="d3">chunk-58067acb0a4b21e48e826dd7e97d86a5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890549</data>
    </node>
    <node id="Starchy-Vegetables">
      <data key="d0">Starchy-Vegetables</data>
      <data key="d1">category</data>
      <data key="d2">Starchy-vegetables include butternut, mealies, potatoes, and sweet potatoes. They are also high in carbs and should be eaten in moderation.</data>
      <data key="d3">chunk-58067acb0a4b21e48e826dd7e97d86a5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890549</data>
    </node>
    <node id="Soluble Fibre">
      <data key="d0">Soluble Fibre</data>
      <data key="d1">category</data>
      <data key="d2">Legumes, sweet potato, oats, and oat bran contain soluble fibre which helps keep blood sugar levels stable by releasing energy slowly into the bloodstream.</data>
      <data key="d3">chunk-58067acb0a4b21e48e826dd7e97d86a5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890549</data>
    </node>
    <node id="Low GI Foods">
      <data key="d0">Low GI Foods</data>
      <data key="d1">category</data>
      <data key="d2">Low GI foods release energy more controlled and sustainably into the bloodstream compared to high GI foods. They include complex and unrefined carbs like wholewheat bread and brown rice, which have a slower rise in blood sugar levels than refined carbs.</data>
      <data key="d3">chunk-58067acb0a4b21e48e826dd7e97d86a5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890549</data>
    </node>
    <node id="Food Labels">
      <data key="d0">Food Labels</data>
      <data key="d1">category</data>
      <data key="d2">Food labels may indicate whether food is low GI or not, aiding in making better food choices for maintaining stable blood sugar levels.&lt;SEP&gt;Food labels provide information about the content of food products including nutrition facts and ingredient lists.</data>
      <data key="d3">chunk-58067acb0a4b21e48e826dd7e97d86a5&lt;SEP&gt;chunk-d5ee0362fd9870828ed03fba0664efdf</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890549</data>
    </node>
    <node id="Legumes">
      <data key="d0">Legumes</data>
      <data key="d1">category</data>
      <data key="d2">Legumes are mentioned as having a low GI (glycaemic index) due to their ability to provide slower-releasing energy into the bloodstream.&lt;SEP&gt;Legumes such as lentils, beans, and chickpeas are part of the plant-based alternatives used to replace meat in various dishes.</data>
      <data key="d3">chunk-58067acb0a4b21e48e826dd7e97d86a5&lt;SEP&gt;chunk-baf922dec0d429fd4c06191ccab7f11c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754897485</data>
    </node>
    <node id="Wholewheat Bread">
      <data key="d0">Wholewheat Bread</data>
      <data key="d1">category</data>
      <data key="d2">Wholewheat bread is a healthier option than white bread as it provides more fiber and other nutrients."&lt;&lt;关系描述&gt;&gt;"Nutritional value, whole grains&lt;SEP&gt;Wholewheat bread is noted for its low GI, causing a more controlled and sustained release of energy compared to regular bread.</data>
      <data key="d3">chunk-58067acb0a4b21e48e826dd7e97d86a5&lt;SEP&gt;chunk-6699a5c79683213ff4dea6e14b493c72</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890550</data>
    </node>
    <node id="Bread">
      <data key="d0">Bread</data>
      <data key="d1">category</data>
      <data key="d2">Bread is a staple in the diet and often consumed alongside other starchy foods, contributing to higher carb intake. It can be combined with potatoes or pasta at a meal."&lt;&lt;关系描述&gt;&gt;"Starchy foods, portion control&lt;SEP&gt;Bread, particularly wholewheat versions, is discussed in the context of starchy foods with high carbs that should be eaten in moderation to maintain stable blood sugar levels.</data>
      <data key="d3">chunk-58067acb0a4b21e48e826dd7e97d86a5&lt;SEP&gt;chunk-6699a5c79683213ff4dea6e14b493c72</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890550</data>
    </node>
    <node id="2023 Diabetes Summit">
      <data key="d0">2023 Diabetes Summit</data>
      <data key="d1">event</data>
      <data key="d2">The 2023 Diabetes Summit is a meeting focused on diabetes prevention and care, with themes aligned to the NSP goals.&lt;SEP&gt;The 2023 Diabetes Summit is an event that brought together various stakeholders including experts, opinion leaders, and individuals living with diabetes to discuss diabetes prevention and control.</data>
      <data key="d3">chunk-6a3470aab48da10bd8a36978481943e4&lt;SEP&gt;chunk-809adfa0a14ab6fe4990c753d1ffe33e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890550</data>
    </node>
    <node id="NSP Goals">
      <data key="d0">NSP Goals</data>
      <data key="d1">category</data>
      <data key="d2">NSP Goals are strategic objectives related to non-communicable diseases (NCDs), including awareness, education, management, surveillance, innovation, and investment in prevention and control.</data>
      <data key="d3">chunk-809adfa0a14ab6fe4990c753d1ffe33e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890550</data>
    </node>
    <node id="National Department of Health (NDOH)">
      <data key="d0">National Department of Health (NDOH)</data>
      <data key="d1">organization</data>
      <data key="d2">The National Department of Health (NDOH) is part of the South African government responsible for health policy and services.</data>
      <data key="d3">chunk-809adfa0a14ab6fe4990c753d1ffe33e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890550</data>
    </node>
    <node id="Diabetes Alliance">
      <data key="d0">Diabetes Alliance</data>
      <data key="d1">organization</data>
      <data key="d2">The Diabetes Alliance is a group committed to working with the South African government to address diabetes challenges and implement recommendations.&lt;SEP&gt;The Diabetes Alliance is committed to increasing advocacy efforts, fostering public-private partnerships, and advocating for dedicated funding streams for diabetes prevention and control within national and provincial healthcare budgets.</data>
      <data key="d3">chunk-46d94ad4db28a87f2b14b78eb3e34260&lt;SEP&gt;chunk-809adfa0a14ab6fe4990c753d1ffe33e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890550</data>
    </node>
    <node id="World Health Organization (WHO)">
      <data key="d0">World Health Organization (WHO)</data>
      <data key="d1">organization</data>
      <data key="d2">The WHO provides global leadership in public health issues, including dietary risks and non-communicable diseases.&lt;SEP&gt;The World Health Organization (WHO) provides guidelines such as Best Buys that can be implemented for public health improvement.&lt;SEP&gt;The World Health Organization is not explicitly mentioned but its tools and recommendations are referenced in the text for diabetes surveillance.</data>
      <data key="d3">chunk-fba3a3b5e0bb473ad31ef851d3b052d8&lt;SEP&gt;chunk-a8a58ab095e62951eddfd80f0a0e2848&lt;SEP&gt;chunk-809adfa0a14ab6fe4990c753d1ffe33e</data>
