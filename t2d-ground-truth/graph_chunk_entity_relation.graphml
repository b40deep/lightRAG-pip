    <node id="restaurants">
      <data key="d0">restaurants</data>
      <data key="d1">organization</data>
      <data key="d2">Restaurants serve prepared foods in portions that can often be larger than necessary, leading to potential overeating.</data>
      <data key="d3">chunk-fb7f9553a2f42b8058dc0445b5667f49</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754897490</data>
