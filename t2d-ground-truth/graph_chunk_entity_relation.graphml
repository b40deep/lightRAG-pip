      <data key="d0">Workstream 4 of the WHO Global Diabetes Compact</data>
      <data key="d1">category</data>
      <data key="d2">This workstream specifically focuses on providing support for regional and national grant proposals aimed at addressing the diabetes burden in South Africa.</data>
      <data key="d3">chunk-46d94ad4db28a87f2b14b78eb3e34260</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890576</data>
    </node>
    <node id="maple syrup">
      <data key="d0">maple syrup</data>
      <data key="d1">ingredient</data>
      <data key="d2">Maple syrup is a sweet, amber-colored liquid made by reducing the sap of maple trees; it's widely used in baking and cooking for its unique flavor.</data>
