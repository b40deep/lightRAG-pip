    <node id="sedentary lifestyles">
      <data key="d0">sedentary lifestyles</data>
      <data key="d1">category</data>
      <data key="d2">Sedentary lifestyles refer to a lack of physical activity and are associated with the increasing incidence of chronic diseases among South Africans.</data>
      <data key="d3">chunk-0b7992edada8563b4687affa28b55ef3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890634</data>
