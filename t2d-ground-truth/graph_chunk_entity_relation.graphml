      <data key="d2">The PROTECTOR programme focuses on integrating telemedicine and proactive care coordination for diabetes patients.</data>
      <data key="d3">chunk-46d94ad4db28a87f2b14b78eb3e34260</data>
      <data key="d4">unknown_source</data>
