    </node>
    <node id="WHO Global Diabetes Compact">
      <data key="d0">WHO Global Diabetes Compact</data>
      <data key="d1">event</data>
      <data key="d2">The WHO Global Diabetes Compact aims to mitigate diabetes risk and ensure equitable access to comprehensive, affordable, and quality management of diabetes, with specific workstream 4 supporting regional and national grant proposals.</data>
      <data key="d3">chunk-46d94ad4db28a87f2b14b78eb3e34260</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890576</data>
    </node>
