      <data key="d4">unknown_source</data>
      <data key="d5">1754890576</data>
    </node>
    <node id="Insufficient Funding in Diabetes Prevention and Control">
      <data key="d0">Insufficient Funding in Diabetes Prevention and Control</data>
      <data key="d1">category</data>
      <data key="d2">South Africa faces a challenge of insufficient funding for diabetes prevention and control, leading to suboptimal diabetes care.</data>
      <data key="d3">chunk-46d94ad4db28a87f2b14b78eb3e34260</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890576</data>
    </node>
    <node id="Diabetes Complications">
      <data key="d0">Diabetes Complications</data>
      <data key="d1">event</data>
      <data key="d2">Suboptimal diabetes care can lead to the development of complications that affect individuals' livelihoods and strain healthcare systems.</data>
      <data key="d3">chunk-46d94ad4db28a87f2b14b78eb3e34260</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754890576</data>
    </node>
    <node id="Discovery Health">
      <data key="d0">Discovery Health</data>
      <data key="d1">organization</data>
      <data key="d2">Discovery Health is a private sector organization that has pioneered an ecosystem for diabetes care in South Africa, emphasizing proactive intervention and self-management.</data>
