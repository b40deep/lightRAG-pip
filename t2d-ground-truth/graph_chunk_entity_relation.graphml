    <node id="Post-natal screening">
      <data key="d0">Post-natal screening</data>
      <data key="d1">category</data>
      <data key="d2">This involves screening mothers for Type 2 diabetes post-delivery, leveraging their regular visits to healthcare facilities.</data>
      <data key="d3">chunk-0c87b51ba48af7d085119b219b21046f</data>
