      <data key="d1">category</data>
      <data key="d2">Physical inactivity is a factor contributing to the high incidence of chronic lifestyle-related illnesses among South Africans.</data>
      <data key="d3">chunk-0b7992edada8563b4687affa28b55ef3</data>
      <data key="d4">unknown_source</data>
